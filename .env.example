# Пример переменных окружения для локального запуска.
#
# Важно:
# - Не коммитить реальные секреты в `.env`.
# - Для Windows/PowerShell удобно копировать этот файл в `.env`.

# API
PORT=3001
HOST=127.0.0.1

# Prisma (Postgres)
# Рекомендуется для Vercel‑деплоя (free): Neon / Supabase (Postgres).
#
# Пример строки подключения:
# DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/DB?sslmode=require"
#
# Важно:
# - `sslmode=require` часто нужен для облачных Postgres‑провайдеров.
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/DB?sslmode=require"
