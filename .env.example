# Пример переменных окружения для локального запуска.
#
# Важно:
# - Не коммитить реальные секреты в `.env`.
# - Для Windows/PowerShell удобно копировать этот файл в `.env`.

# API
PORT=3001
HOST=127.0.0.1

# Local capture mode
# Для локального capture site оставьте DATABASE_URL незаданным.
# Тогда API будет писать пары в apps/api/storage/cases.jsonl.
# LOCAL_CAPTURE_STORAGE_DIR="D:/dev/CatsScreening/.tmp/capture-storage"

# Prisma / Postgres
# Задавайте DATABASE_URL только когда подключаете облачный Postgres.
# Пример:
# DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/DB?sslmode=require"

# Future object storage credentials
# Текущая ветка использует local-file adapter. После выбора провайдера сюда добавятся
# Cloudflare R2 / Vercel Blob / S3-compatible переменные.
