# Node / build artifacts
node_modules/
dist/
.turbo/

# Python / локальное воспроизводимое ML-окружение
__pycache__/
*.py[cod]
.pytest_cache/
.venv/

# Env (секреты)
.env
.env.*
!.env.example

# Временные данные (но отчёты по шагам храним в репозитории)
.tmp/*
!.tmp/reports/
!.tmp/reports/**

# Локальные БД/кэши
.tmp/db/
.tmp/storage/
apps/api/prisma/*.db
apps/api/prisma/*.db-journal

# Исходный датасет фото нужен заказчикам для ROI-разметки, поэтому коммитим его в git.

# Локальное файловое хранилище (dev)
apps/api/storage/*
!apps/api/storage/.gitkeep
