[Unit]
Description=CatsScreening API
After=network.target

[Service]
Type=simple
User=catscreen
Group=catscreen
WorkingDirectory=/opt/cats-screening/current
Environment=NODE_ENV=production
Environment=HOST=127.0.0.1
Environment=PORT=3001
Environment=LOCAL_CAPTURE_STORAGE_DIR=/var/lib/cats-screening/storage
Environment=NPM_CONFIG_CACHE=/var/lib/cats-screening/.npm
ExecStart=/usr/bin/npm run start --workspace apps/api
Restart=always
RestartSec=5
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ReadWritePaths=/var/lib/cats-screening/storage

[Install]
WantedBy=multi-user.target
